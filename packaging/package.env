# Debian package metadata for this Safelibs port.
# Future ports must replace the .invalid maintainer email with a real contact.

DEB_PACKAGE="safelibs-port-template"
DEB_VERSION="0.0.0"
DEB_ARCHITECTURE="auto"
DEB_MAINTAINER="Safelibs <safelibs@example.invalid>"
DEB_SECTION="libs"
DEB_PRIORITY="optional"
DEB_DESCRIPTION="Safe library artifacts for this Safelibs port."
DEB_INSTALL_PREFIX="/usr/lib/safelibs/safelibs-port-template"
DEB_DEPENDS=""
